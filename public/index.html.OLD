<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Xưởng QC — Test Đốt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --charcoal: #1D1B18;
    --charcoal-2: #2A2723;
    --paper: #F6F3EC;
    --paper-2: #EDE8DC;
    --line: #DDD5C4;
    --copper: #B5622C;
    --copper-dark: #8F4A20;
    --ink: #2A2622;
    --ink-soft: #6B6255;
    --pass: #3F7D53;
    --pass-bg: #E4EFE6;
    --fail: #A83A2E;
    --fail-bg: #F5E4E1;
    --pending: #9A8B5F;
    --pending-bg: #EFEAD8;
    --radius: 3px;
  }
  *{ box-sizing: border-box; }
  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  ::selection{ background: var(--copper); color: white; }

  /* ---- Header ---- */
  header{
    background: var(--charcoal);
    color: var(--paper);
    padding: 22px 32px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom: 3px solid var(--copper);
  }
  .brand{ display:flex; align-items:center; gap:14px; }
  .brand-mark{
    width:38px; height:38px;
    border:2px solid var(--copper);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif;
    font-weight:700; font-size:15px;
    color: var(--copper);
    flex-shrink:0;
  }
  .brand h1{
    font-family:'Space Grotesk', sans-serif;
    font-size: 19px;
    font-weight:600;
    margin:0;
    letter-spacing:0.2px;
  }
  .brand span{
    display:block;
    font-size:11.5px;
    color:#A69B8B;
    font-weight:400;
    letter-spacing:0.5px;
    text-transform:uppercase;
    margin-top:2px;
  }
  .header-stats{ display:flex; gap:26px; }
  .stat{ text-align:right; }
  .stat b{
    display:block; font-family:'IBM Plex Mono', monospace;
    font-size:22px; font-weight:600; color: var(--paper);
  }
  .stat small{ font-size:10.5px; color:#A69B8B; text-transform:uppercase; letter-spacing:0.5px; }

  main{ max-width: 1180px; margin: 0 auto; padding: 32px; }

  .layout{ display:grid; grid-template-columns: 400px 1fr; gap: 28px; align-items:start; }
  @media (max-width: 920px){ .layout{ grid-template-columns: 1fr; } }

  .card{
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .card-head{
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between;
  }
  .card-head h2{
    font-family:'Space Grotesk', sans-serif;
    font-size:15px; margin:0; font-weight:600;
  }
  .eyebrow{
    font-size:10.5px; text-transform:uppercase; letter-spacing:0.8px;
    color: var(--copper-dark); font-weight:600;
  }

  /* ---- Form ---- */
  form.entry{ padding: 20px; }
  fieldset{
    border:none; padding:0; margin:0 0 20px 0;
  }
  legend{
    font-size:11px; text-transform:uppercase; letter-spacing:0.6px;
    color: var(--ink-soft); font-weight:600; margin-bottom:10px;
    padding-bottom:6px; border-bottom: 1px dashed var(--line); width:100%;
  }
  .field-row{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:10px; }
  .field{ margin-bottom:10px; }
  .field label{
    display:block; font-size:12px; font-weight:500; color: var(--ink-soft);
    margin-bottom:4px;
  }
  .field input, .field select{
    width:100%; padding: 9px 10px;
    border:1px solid var(--line); border-radius: var(--radius);
    background: var(--paper);
    font-family:'Inter', sans-serif; font-size:13.5px; color: var(--ink);
  }
  .field input:focus, .field select:focus{
    outline: none; border-color: var(--copper); background:white;
    box-shadow: 0 0 0 3px rgba(181,98,44,0.12);
  }
  .field.mono input{ font-family:'IBM Plex Mono', monospace; }

  .result-toggle{ display:flex; gap:8px; }
  .result-toggle input{ display:none; }
  .result-toggle label{
    flex:1; text-align:center; padding:10px 0; cursor:pointer;
    border:1.5px solid var(--line); border-radius: var(--radius);
    font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:13px;
    color: var(--ink-soft); margin:0; transition: all .12s ease;
  }
  .result-toggle input:checked + label.pass{ background: var(--pass-bg); border-color: var(--pass); color: var(--pass); }
  .result-toggle input:checked + label.fail{ background: var(--fail-bg); border-color: var(--fail); color: var(--fail); }
  .result-toggle input:checked + label.pending{ background: var(--pending-bg); border-color: var(--pending); color: var(--pending); }

  .btn{
    width:100%; padding: 12px; margin-top: 6px;
    background: var(--copper); color:white; border:none; border-radius: var(--radius);
    font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:14px;
    cursor:pointer; letter-spacing:0.2px;
    transition: background .12s ease;
  }
  .btn:hover{ background: var(--copper-dark); }
  .btn:disabled{ background:#C9BBA6; cursor:not-allowed; }
  .btn-ghost{
    background:transparent; color: var(--copper-dark); border: 1px solid var(--copper-dark);
  }
  .btn-ghost:hover{ background: rgba(181,98,44,0.08); }

  .msg{ font-size:12.5px; margin-top:10px; padding:8px 10px; border-radius: var(--radius); display:none; }
  .msg.show{ display:block; }
  .msg.ok{ background: var(--pass-bg); color: var(--pass); }
  .msg.err{ background: var(--fail-bg); color: var(--fail); }

  .quick-add{ padding: 14px 20px; border-top: 1px solid var(--line); background: var(--paper-2); }
  .quick-add summary{ cursor:pointer; font-size:12.5px; font-weight:600; color: var(--ink-soft); }
  .quick-add .field-row{ margin-top:12px; }

  /* ---- List / Table ---- */
  .filters{ padding: 14px 20px; border-bottom:1px solid var(--line); display:flex; gap:8px; flex-wrap:wrap; }
  .filters select, .filters input{
    padding: 7px 9px; border:1px solid var(--line); border-radius: var(--radius);
    font-size:12.5px; background: var(--paper); font-family:'Inter', sans-serif;
  }
  table{ width:100%; border-collapse: collapse; font-size:13px; }
  thead th{
    text-align:left; padding: 10px 14px; background: var(--paper-2);
    font-size:10.5px; text-transform:uppercase; letter-spacing:0.4px;
    color: var(--ink-soft); font-weight:600; border-bottom:1px solid var(--line);
    position: sticky; top:0;
  }
  tbody td{ padding: 11px 14px; border-bottom: 1px solid var(--line); vertical-align:middle; }
  tbody tr:hover{ background: rgba(181,98,44,0.04); }
  td.mono{ font-family:'IBM Plex Mono', monospace; font-size:12.5px; }
  td.empty-state{ text-align:center; color: var(--ink-soft); padding: 40px 0; font-size:13px; }

  /* Stamp badge — signature element */
  .stamp{
    display:inline-flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:11px;
    letter-spacing:1px; padding: 4px 10px;
    border:1.5px solid; border-radius: 2px;
    transform: rotate(-3deg);
  }
  .stamp.pass{ color: var(--pass); border-color: var(--pass); background: var(--pass-bg); }
  .stamp.fail{ color: var(--fail); border-color: var(--fail); background: var(--fail-bg); }
  .stamp.pending{ color: var(--pending); border-color: var(--pending); background: var(--pending-bg); transform:none; }

  .table-wrap{ max-height: 560px; overflow-y:auto; }

  .list-foot{
    padding: 10px 20px; display:flex; justify-content:space-between; align-items:center;
    border-top:1px solid var(--line); background: var(--paper-2);
    font-size:12px; color: var(--ink-soft);
  }

  /* ---- Edit mode ---- */
  .card.editing{ box-shadow: 0 0 0 2px var(--copper); }
  .eyebrow.editing{ color: var(--fail); }
  #cancelEditBtn{ margin-top:8px; }

  .row-actions{ display:flex; gap:6px; }
  .icon-btn{
    border:1px solid var(--line); background:white; border-radius: var(--radius);
    width:28px; height:28px; cursor:pointer; font-size:13px;
    display:inline-flex; align-items:center; justify-content:center;
    color: var(--ink-soft); transition: all .12s ease;
  }
  .icon-btn:hover{ border-color: var(--copper); color: var(--copper-dark); background: rgba(181,98,44,0.06); }
  .icon-btn.danger:hover{ border-color: var(--fail); color: var(--fail); background: var(--fail-bg); }
  tr.editing-row{ background: rgba(181,98,44,0.08) !important; }

  footer{ text-align:center; padding: 24px; font-size:11.5px; color: var(--ink-soft); }

  /* ---- Product link ---- */
  .product-link{
    color: var(--copper-dark); text-decoration: none; font-weight:600;
    border-bottom: 1px dashed var(--copper-dark);
  }
  .product-link:hover{ color: var(--copper); border-bottom-style: solid; }

  /* ---- Image detail modal ---- */
  .modal-overlay{
    display:none; position:fixed; inset:0; background: rgba(29,27,24,0.72);
    z-index: 100; align-items:center; justify-content:center; padding: 24px;
  }
  .modal-overlay.show{ display:flex; }
  .modal{
    background: var(--paper); border-radius: var(--radius);
    max-width: 880px; width:100%; max-height: 88vh; overflow-y:auto;
    border-top: 4px solid var(--copper);
  }
  .modal-head{
    padding: 20px 26px; border-bottom:1px solid var(--line);
    display:flex; align-items:flex-start; justify-content:space-between;
    background: white;
  }
  .modal-head h2{
    font-family:'Space Grotesk', sans-serif; font-size:20px; margin:0 0 6px 0;
    font-weight:700;
  }
  .modal-meta{ display:flex; gap:14px; flex-wrap:wrap; font-size:12.5px; color: var(--ink-soft); }
  .modal-meta b{ color: var(--ink); font-family:'IBM Plex Mono', monospace; }
  .modal-close{
    background:none; border:none; font-size:22px; cursor:pointer;
    color: var(--ink-soft); line-height:1; padding:4px;
  }
  .modal-close:hover{ color: var(--fail); }

  .pic-grid{
    display:grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px; padding: 24px 26px;
  }
  .pic-slot{
    background: white; border: 1px solid var(--line); border-radius: var(--radius);
    overflow:hidden; display:flex; flex-direction:column;
  }
  .pic-slot .pic-frame{
    aspect-ratio: 1 / 1; background: var(--paper-2);
    display:flex; align-items:center; justify-content:center;
    position:relative; overflow:hidden;
    transition: background .12s ease, box-shadow .12s ease;
  }
  .pic-slot .pic-frame.drag-over{
    background: var(--pass-bg);
    box-shadow: inset 0 0 0 2px var(--copper);
  }
  .pic-slot .pic-frame.uploading{ opacity: 0.5; }
  .pic-frame .drop-hint{
    position:absolute; inset:0; display:none; align-items:center; justify-content:center;
    background: rgba(181,98,44,0.12); color: var(--copper-dark);
    font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:12px;
    text-align:center; padding:8px; pointer-events:none;
  }
  .pic-frame.drag-over .drop-hint{ display:flex; }
  .pic-frame .spinner{
    display:none; width:22px; height:22px; border-radius:50%;
    border: 3px solid var(--line); border-top-color: var(--copper);
    animation: spin 0.7s linear infinite;
  }
  .pic-frame.uploading .spinner{ display:block; }
  @keyframes spin{ to{ transform: rotate(360deg); } }
  .pic-slot .pic-frame img{
    width:100%; height:100%; object-fit: cover; display:block;
    cursor: zoom-in;
  }
  .pic-slot .pic-empty{
    color: var(--ink-soft); font-size:11.5px; text-align:center; padding: 10px;
    line-height:1.5; cursor:pointer;
  }
  .pic-slot .pic-empty span{ display:block; font-size:22px; margin-bottom:6px; opacity:0.5; }
  .pic-label{
    padding: 8px 10px; font-family:'Space Grotesk', sans-serif; font-size:12px;
    font-weight:600; color: var(--ink-soft); display:flex; justify-content:space-between; align-items:center;
    border-top: 1px solid var(--line);
  }
  .pic-upload-btn{
    font-size:11px; color: var(--copper-dark); cursor:pointer; text-decoration:underline;
    background:none; border:none; padding:0; font-family:'Inter',sans-serif;
  }

  /* Lightbox phóng to ảnh */
  .lightbox{
    display:none; position:fixed; inset:0; background: rgba(0,0,0,0.88);
    z-index: 200; align-items:center; justify-content:center; padding: 30px;
  }
  .lightbox.show{ display:flex; }
  .lightbox img{ max-width:100%; max-height:100%; border-radius: var(--radius); }
</style>
</head>
<body>

<header>
  <div class="brand">
    <div class="brand-mark">QC</div>
    <div>
      <h1>Sổ Theo Dõi Test Đốt</h1>
      <span>Burn Test Tracking · Xưởng sản xuất</span>
    </div>
  </div>
  <div class="header-stats">
    <div class="stat"><b id="statTotal">–</b><small>Tổng test</small></div>
    <div class="stat"><b id="statPass" style="color:#7FBB93">–</b><small>Pass</small></div>
    <div class="stat"><b id="statFail" style="color:#E39C90">–</b><small>Fail</small></div>
  </div>
</header>

<main>
  <div class="layout">

    <!-- ============ FORM NHẬP LIỆU ============ -->
    <div class="card">
      <div class="card-head">
        <h2 id="formTitle">Nhập kết quả test</h2>
        <span class="eyebrow" id="formEyebrow">Mới</span>
      </div>
      <form class="entry" id="entryForm">
        <input type="hidden" id="edit_id" value="">

        <fieldset>
          <legend>Đơn hàng</legend>
          <div class="field">
            <label for="po_id">PO (mã đơn hàng)</label>
            <select id="po_id" required></select>
          </div>
        </fieldset>

        <fieldset>
          <legend>Thông tin sản phẩm</legend>
          <div class="field mono">
            <label for="product_code">Mã sản phẩm (Product Code)</label>
            <input type="text" id="product_code" placeholder="VD: 22010AN" required>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="diameter">Đường kính (mm)</label>
              <input type="number" step="0.1" id="diameter" placeholder="70">
            </div>
            <div class="field">
              <label for="height">Chiều cao (mm)</label>
              <input type="number" step="0.1" id="height" placeholder="80">
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="color">Màu (Color)</label>
              <input type="text" id="color" placeholder="WHITE">
            </div>
            <div class="field">
              <label for="frag">Mùi hương (Frag)</label>
              <input type="text" id="frag" placeholder="ABC">
            </div>
          </div>
          <div class="field">
            <label for="wick">Loại tim (Wick)</label>
            <input type="text" id="wick" placeholder="T27">
          </div>
        </fieldset>

        <fieldset>
          <legend>Thông số test đốt</legend>
          <div class="field">
            <label for="temperature">Nhiệt độ (°C)</label>
            <input type="number" step="0.1" id="temperature" placeholder="20">
          </div>
          <div class="field-row">
            <div class="field">
              <label for="start_datetime">Start — Ngày giờ bắt đầu</label>
              <input type="datetime-local" id="start_datetime">
            </div>
            <div class="field">
              <label for="end_datetime">End — Ngày giờ kết thúc</label>
              <input type="datetime-local" id="end_datetime">
            </div>
          </div>
          <div class="field">
            <label for="total_burn_time">Total Burn Time — Tổng thời gian đốt thực tế</label>
            <input type="text" id="total_burn_time" placeholder="VD: 12:00 hoặc 12 giờ">
            <small style="display:block; margin-top:4px; color:var(--ink-soft); font-size:10.5px;">
              Nhập thủ công. Không tính theo Start → End vì test có thời gian nghỉ giữa các chu kỳ.
            </small>
          </div>
          <input type="hidden" id="test_date" value="">
          <div class="field-row">
            <div class="field">
              <label for="tester">Người test</label>
              <input type="text" id="tester" placeholder="HIẾU">
            </div>
            <div class="field">
              <label for="approved">Người duyệt</label>
              <input type="text" id="approved" placeholder="QUYẾT">
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Kết quả</legend>
          <div class="result-toggle">
            <input type="radio" name="test_result" id="res_pending" value="" checked>
            <label for="res_pending" class="pending">⏳ CHỜ</label>
            <input type="radio" name="test_result" id="res_pass" value="PASS">
            <label for="res_pass" class="pass">✓ PASS</label>
            <input type="radio" name="test_result" id="res_fail" value="FAIL">
            <label for="res_fail" class="fail">✕ FAIL</label>
          </div>
        </fieldset>

        <button type="submit" class="btn" id="submitBtn">Lưu kết quả test</button>
        <button type="button" class="btn btn-ghost" id="cancelEditBtn" style="display:none;">Hủy chỉnh sửa</button>
        <div class="msg" id="formMsg"></div>
      </form>

      <details class="quick-add">
        <summary>+ Thêm khách hàng / PO mới</summary>
        <div class="field-row">
          <div class="field">
            <label for="new_client_name">Tên khách hàng mới</label>
            <input type="text" id="new_client_name" placeholder="VD: CBE">
          </div>
          <div class="field" style="display:flex; align-items:flex-end;">
            <button type="button" class="btn btn-ghost" id="addClientBtn" style="margin:0;">Thêm KH</button>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="new_po_client">Thuộc khách hàng</label>
            <select id="new_po_client"></select>
          </div>
          <div class="field">
            <label for="new_po_name">Tên PO mới</label>
            <input type="text" id="new_po_name" placeholder="VD: YN25-0168">
          </div>
        </div>
        <button type="button" class="btn btn-ghost" id="addPoBtn">Thêm PO</button>
        <div class="msg" id="quickMsg"></div>
      </details>
    </div>

    <!-- ============ DANH SÁCH ============ -->
    <div class="card">
      <div class="card-head">
        <h2>Nhật ký test</h2>
        <button class="btn btn-ghost" id="refreshBtn" style="width:auto; padding:7px 14px; font-size:12.5px; margin:0;">↻ Làm mới</button>
      </div>
      <div class="filters">
        <select id="filterPo"><option value="">Tất cả PO</option></select>
        <select id="filterResult">
          <option value="">Tất cả kết quả</option>
          <option value="PASS">PASS</option>
          <option value="FAIL">FAIL</option>
        </select>
        <input type="text" id="filterProduct" placeholder="Tìm mã sản phẩm...">
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Mã SP</th>
              <th>PO</th>
              <th>Ø / Cao</th>
              <th>Nhiệt độ</th>
              <th>Start / End</th>
              <th>Tester</th>
              <th>Kết quả</th>
              <th>Ảnh</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody id="tableBody">
            <tr><td colspan="9" class="empty-state">Đang tải dữ liệu…</td></tr>
          </tbody>
        </table>
      </div>
      <div class="list-foot">
        <span id="countLabel">0 bản ghi</span>
        <span>Cập nhật lúc <span id="lastUpdated">–</span></span>
      </div>
    </div>

  </div>
</main>

<footer>Burn Test Tracking API · dữ liệu lưu tại SQLite nội bộ</footer>

<!-- ============ MODAL XEM 5 ẢNH TEST ĐỐT ============ -->
<div class="modal-overlay" id="imageModal">
  <div class="modal">
    <div class="modal-head">
      <div>
        <h2 id="modalProductCode">—</h2>
        <div class="modal-meta">
          <span>PO: <b id="modalPo">—</b></span>
          <span>Start: <b id="modalStart">—</b></span>
          <span>End: <b id="modalEnd">—</b></span>
          <span>Tổng đốt: <b id="modalBurnTime">—</b></span>
          <span>Nhiệt độ: <b id="modalTemp">—</b></span>
          <span>Kết quả: <span id="modalResult"></span></span>
        </div>
      </div>
      <button class="modal-close" onclick="closeImageModal()">✕</button>
    </div>
    <div class="pic-grid" id="picGrid"></div>
  </div>
</div>

<!-- Lightbox phóng to 1 ảnh -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <img id="lightboxImg" src="" alt="Ảnh test đốt phóng to">
</div>


<script>
const API = '/api/v1';
let clientsCache = [];
let posCache = [];
let currentEditId = null;
let rowsCache = {};

// ---------- Helpers ----------
function showMsg(el, text, isErr){
  el.textContent = text;
  el.className = 'msg show ' + (isErr ? 'err' : 'ok');
  setTimeout(() => el.classList.remove('show'), 3500);
}
function formatDateTime(value){
  if(!value) return '—';
  return String(value).replace('T',' ');
}
function stampHtml(result){
  if(result === 'PASS') return '<span class="stamp pass">PASS</span>';
  if(result === 'FAIL') return '<span class="stamp fail">FAIL</span>';
  return '<span class="stamp pending">CHỜ</span>';
}
function todayISO(){
  return new Date().toISOString().slice(0,10);
}
function localDateTimeValue(){
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function syncTestDateFromStart(){
  const start = document.getElementById('start_datetime').value;
  document.getElementById('test_date').value = start ? start.slice(0,10) : todayISO();
}
document.getElementById('start_datetime').value = localDateTimeValue();
syncTestDateFromStart();
document.getElementById('start_datetime').addEventListener('change', syncTestDateFromStart);

// ---------- Load Clients & POs into selects ----------
async function loadClientsAndPos(){
  const [clients, pos] = await Promise.all([
    fetch(`${API}/clients`).then(r => r.json()),
    fetch(`${API}/pos`).then(r => r.json())
  ]);
  clientsCache = clients;
  posCache = pos;

  const clientMap = Object.fromEntries(clients.map(c => [c.Cus_id, c.Cus_Name]));

  const poSelect = document.getElementById('po_id');
  const filterPo = document.getElementById('filterPo');
  const newPoClient = document.getElementById('new_po_client');

  poSelect.innerHTML = pos.map(p =>
    `<option value="${p.PO_Id}">${p.PO_Name} — ${clientMap[p.Cus_id] || '?'}</option>`
  ).join('') || '<option value="">Chưa có PO nào</option>';

  filterPo.innerHTML = '<option value="">Tất cả PO</option>' + pos.map(p =>
    `<option value="${p.PO_Id}">${p.PO_Name}</option>`
  ).join('');

  newPoClient.innerHTML = clients.map(c =>
    `<option value="${c.Cus_id}">${c.Cus_Name}</option>`
  ).join('') || '<option value="">Chưa có khách hàng</option>';
}

// ---------- Load PO_Detail table ----------
async function loadTable(){
  const po_id = document.getElementById('filterPo').value;
  const test_result = document.getElementById('filterResult').value;
  const product_code = document.getElementById('filterProduct').value;

  const params = new URLSearchParams();
  if(po_id) params.set('po_id', po_id);
  if(test_result) params.set('test_result', test_result);
  if(product_code) params.set('product_code', product_code);

  const rows = await fetch(`${API}/po-details?${params}`).then(r => r.json());
  const poMap = Object.fromEntries(posCache.map(p => [p.PO_Id, p.PO_Name]));
  rowsCache = Object.fromEntries(rows.map(r => [r.Id, r]));

  const tbody = document.getElementById('tableBody');
  if(!rows.length){
    tbody.innerHTML = '<tr><td colspan="9" class="empty-state">Chưa có bản ghi test nào</td></tr>';
  } else {
    tbody.innerHTML = rows.map(r => `
      <tr id="row-${r.Id}" class="${Number(currentEditId) === r.Id ? 'editing-row' : ''}">
        <td class="mono"><a href="#" class="product-link" onclick="openImageModal(${r.Id}); return false;">${r.Product_Code}</a></td>
        <td>${poMap[r.PO_Id] || r.PO_Id}</td>
        <td class="mono">${r.Diameter ?? '—'} / ${r.Height ?? '—'}</td>
        <td class="mono">${r.Temperature ?? '—'}°C</td>
        <td class="mono">${formatDateTime(r.Start)}<br><span style="color:var(--ink-soft)">${formatDateTime(r.End)}</span></td>
        <td>${r.Tester ?? '—'}</td>
        <td>${stampHtml(r.Test_result)}</td>
        <td>${renderPics(r)}</td>
        <td>
          <div class="row-actions">
            <button type="button" class="icon-btn" title="Sửa" onclick="editRow(${r.Id})">✎</button>
            <button type="button" class="icon-btn danger" title="Xóa" onclick="deleteRow(${r.Id})">🗑</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  document.getElementById('countLabel').textContent = `${rows.length} bản ghi`;
  document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString('vi-VN');

  // Stats (không phụ thuộc filter)
  const summary = await fetch(`${API}/po-details/summary`).then(r => r.json());
  document.getElementById('statTotal').textContent = summary.total ?? 0;
  document.getElementById('statPass').textContent = summary.pass_count ?? 0;
  document.getElementById('statFail').textContent = summary.fail_count ?? 0;
}

function renderPics(r){
  const filled = [1,2,3,4,5].filter(i => r['PIC_' + i]).length;
  return `<label style="cursor:pointer; color:var(--copper-dark); font-size:12px; text-decoration:underline;">
    ${filled}/5 ảnh
    <input type="file" accept="image/*" style="display:none" onchange="uploadImage(${r.Id}, this)">
  </label>`;
}

async function uploadImage(id, input){
  const file = input.files[0];
  if(!file) return;
  const slotInput = prompt('Nhập vị trí ảnh (PIC_1, PIC_2, PIC_3, PIC_4 hoặc PIC_5):', 'PIC_1');
  if(!slotInput) return;
  const match = String(slotInput).trim().toUpperCase().match(/^PIC[_-]?([1-5])$/);
  if(!match){ alert('Vị trí ảnh không hợp lệ. Hãy nhập PIC_1 đến PIC_5.'); return; }
  const fd = new FormData();
  fd.append('pic_slot', match[1]);
  fd.append('file', file);
  const res = await fetch(`${API}/po-details/${id}/images`, { method:'POST', body: fd });
  if(res.ok){ loadTable(); } else { alert('Lỗi upload ảnh'); }
}

// ---------- Modal xem 5 ảnh test đốt ----------
const PIC_SLOTS = ['PIC_1', 'PIC_2', 'PIC_3', 'PIC_4', 'PIC_5'];

async function openImageModal(id){
  let r = rowsCache[id];
  if(!r){
    r = await fetch(`${API}/po-details/${id}`).then(res => res.json());
  }
  if(r.error){ alert('Không tải được dữ liệu bản ghi'); return; }

  document.getElementById('modalProductCode').textContent = r.Product_Code;
  document.getElementById('modalPo').textContent = (posCache.find(p => p.PO_Id === r.PO_Id) || {}).PO_Name || r.PO_Id;
  document.getElementById('modalStart').textContent = formatDateTime(r.Start);
  document.getElementById('modalEnd').textContent = formatDateTime(r.End);
  document.getElementById('modalBurnTime').textContent = r.Total_Burn_Time || '—';
  document.getElementById('modalTemp').textContent = r.Temperature != null ? r.Temperature + '°C' : '—';
  document.getElementById('modalResult').innerHTML = stampHtml(r.Test_result);

  document.getElementById('picGrid').innerHTML = PIC_SLOTS.map((slot, i) => {
    const url = r[slot];
    const num = i + 1;
    return `
      <div class="pic-slot">
        <div class="pic-frame" data-slot="${slot}" data-id="${r.Id}">
          ${url
            ? `<img src="${url}" alt="Ảnh test đốt ${num}" onclick="openLightbox('${url}')">`
            : `<div class="pic-empty"><span>🖼</span>Kéo ảnh vào đây<br>hoặc bấm để chọn</div>`
          }
          <div class="drop-hint">Thả ảnh vào đây</div>
          <div class="spinner"></div>
        </div>
        <div class="pic-label">
          <span>Ảnh ${num}</span>
          <label class="pic-upload-btn">
            ${url ? 'Thay ảnh' : 'Tải lên'}
            <input type="file" accept="image/*" style="display:none" onchange="uploadImageToSlot(${r.Id}, '${slot}', this.files[0])">
          </label>
        </div>
      </div>
    `;
  }).join('');

  wireDragAndDrop();
  document.getElementById('imageModal').classList.add('show');
}

function closeImageModal(){
  document.getElementById('imageModal').classList.remove('show');
}

// ---------- Kéo-thả ảnh vào từng ô PIC ----------
function wireDragAndDrop(){
  document.querySelectorAll('.pic-frame').forEach(frame => {
    const id = frame.dataset.id;
    const slot = frame.dataset.slot;

    // Bấm trực tiếp vào khung ảnh (khi chưa có ảnh) cũng mở hộp thoại chọn file
    frame.addEventListener('click', (e) => {
      if(frame.classList.contains('uploading')) return;
      if(e.target.tagName === 'IMG') return; // click ảnh đã có -> mở lightbox (đã xử lý riêng)
      const input = frame.parentElement.querySelector('input[type=file]');
      if(input) input.click();
    });

    ['dragenter', 'dragover'].forEach(evt => {
      frame.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation();
        frame.classList.add('drag-over');
      });
    });
    ['dragleave', 'dragend'].forEach(evt => {
      frame.addEventListener(evt, (e) => {
        e.preventDefault(); e.stopPropagation();
        frame.classList.remove('drag-over');
      });
    });
    frame.addEventListener('drop', (e) => {
      e.preventDefault(); e.stopPropagation();
      frame.classList.remove('drag-over');
      const file = e.dataTransfer.files && e.dataTransfer.files[0];
      if(!file) return;
      if(!file.type.startsWith('image/')){
        alert('Chỉ chấp nhận file ảnh (jpg, png...)');
        return;
      }
      uploadImageToSlot(id, slot, file, frame);
    });
  });
}

async function uploadImageToSlot(id, slot, file, frameEl){
  if(!file) return;
  const frame = frameEl || document.querySelector(`.pic-frame[data-slot="${slot}"][data-id="${id}"]`);
  if(frame) frame.classList.add('uploading');

  const fd = new FormData();
  const slotNumber = String(slot).match(/([1-5])$/)?.[1];
  if(!slotNumber){
    if(frame) frame.classList.remove('uploading');
    alert('Vị trí ảnh không hợp lệ.');
    return;
  }
  fd.append('pic_slot', slotNumber);
  fd.append('file', file);
  try{
    const res = await fetch(`${API}/po-details/${id}/images`, { method:'POST', body: fd });
    if(!res.ok){
      const data = await res.json().catch(() => ({}));
      throw new Error(data.error || 'Lỗi upload ảnh');
    }
    await loadTable();
    openImageModal(id); // refresh modal với ảnh mới
  } catch(err){
    alert('✕ ' + err.message);
    if(frame) frame.classList.remove('uploading');
  }
}

function openLightbox(url){
  document.getElementById('lightboxImg').src = url;
  document.getElementById('lightbox').classList.add('show');
}
function closeLightbox(){
  document.getElementById('lightbox').classList.remove('show');
}

document.getElementById('imageModal').addEventListener('click', (e) => {
  if(e.target.id === 'imageModal') closeImageModal();
});
document.addEventListener('keydown', (e) => {
  if(e.key === 'Escape'){ closeLightbox(); closeImageModal(); }
});

// Chặn trình duyệt tự mở ảnh nếu người dùng lỡ thả ra ngoài khung ảnh
['dragover', 'drop'].forEach(evt => {
  document.addEventListener(evt, (e) => {
    if(e.target.closest && e.target.closest('.pic-frame')) return;
    e.preventDefault();
  });
});

// ---------- Sửa bản ghi ----------
async function editRow(id){
  const msg = document.getElementById('formMsg');
  try{
    const r = await fetch(`${API}/po-details/${id}`).then(res => res.json());
    if(r.error) throw new Error(r.error);

    document.getElementById('edit_id').value = r.Id;
    document.getElementById('po_id').value = r.PO_Id;
    document.getElementById('product_code').value = r.Product_Code ?? '';
    document.getElementById('diameter').value = r.Diameter ?? '';
    document.getElementById('height').value = r.Height ?? '';
    document.getElementById('color').value = r.Color ?? '';
    document.getElementById('frag').value = r.Frag ?? '';
    document.getElementById('wick').value = r.Wick ?? '';
    document.getElementById('temperature').value = r.Temperature ?? '';
    document.getElementById('start_datetime').value = r.Start ?? '';
    document.getElementById('end_datetime').value = r.End ?? '';
    document.getElementById('total_burn_time').value = r.Total_Burn_Time ?? '';
    document.getElementById('test_date').value = r.Test_date ?? (r.Start ? r.Start.slice(0,10) : todayISO());
    document.getElementById('tester').value = r.Tester ?? '';
    document.getElementById('approved').value = r.Approved ?? '';

    document.getElementById('res_pass').checked = r.Test_result === 'PASS';
    document.getElementById('res_fail').checked = r.Test_result === 'FAIL';
    document.getElementById('res_pending').checked = !r.Test_result;

    enterEditMode(r.Id);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }catch(err){
    showMsg(msg, '✕ Không tải được bản ghi: ' + err.message, true);
  }
}

function enterEditMode(id){
  currentEditId = id;
  document.querySelector('.card').classList.add('editing');
  document.getElementById('formTitle').textContent = `Sửa kết quả test #${id}`;
  document.getElementById('formEyebrow').textContent = 'Đang sửa';
  document.getElementById('formEyebrow').classList.add('editing');
  document.getElementById('submitBtn').textContent = 'Cập nhật kết quả';
  document.getElementById('cancelEditBtn').style.display = 'block';
  loadTable();
}

function exitEditMode(){
  currentEditId = null;
  document.getElementById('edit_id').value = '';
  document.querySelector('.card').classList.remove('editing');
  document.getElementById('formTitle').textContent = 'Nhập kết quả test';
  document.getElementById('formEyebrow').textContent = 'Mới';
  document.getElementById('formEyebrow').classList.remove('editing');
  document.getElementById('submitBtn').textContent = 'Lưu kết quả test';
  document.getElementById('cancelEditBtn').style.display = 'none';
  document.getElementById('entryForm').reset();
  document.getElementById('start_datetime').value = localDateTimeValue();
  document.getElementById('end_datetime').value = '';
  document.getElementById('total_burn_time').value = '';
  syncTestDateFromStart();
  loadTable();
}

document.getElementById('cancelEditBtn').addEventListener('click', exitEditMode);

// ---------- Xóa bản ghi ----------
async function deleteRow(id){
  if(!confirm(`Xóa bản ghi test #${id}? Hành động này không thể hoàn tác.`)) return;
  const res = await fetch(`${API}/po-details/${id}`, { method: 'DELETE' });
  if(res.ok || res.status === 204){
    if(currentEditId === id) exitEditMode();
    loadTable();
  } else {
    alert('Lỗi khi xóa bản ghi');
  }
}

// ---------- Submit form nhập test ----------
document.getElementById('entryForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submitBtn');
  const msg = document.getElementById('formMsg');

  const resultEl = document.querySelector('input[name="test_result"]:checked');
  const payload = {
    po_id: Number(document.getElementById('po_id').value),
    product_code: document.getElementById('product_code').value.trim(),
    diameter: document.getElementById('diameter').value || null,
    height: document.getElementById('height').value || null,
    frag: document.getElementById('frag').value || null,
    color: document.getElementById('color').value || null,
    wick: document.getElementById('wick').value || null,
    temperature: document.getElementById('temperature').value || null,
    start_datetime: document.getElementById('start_datetime').value || null,
    end_datetime: document.getElementById('end_datetime').value || null,
    total_burn_time: document.getElementById('total_burn_time').value.trim() || null,
    test_date: (document.getElementById('start_datetime').value || '').slice(0,10) || document.getElementById('test_date').value || todayISO(),
    time: (document.getElementById('start_datetime').value || '').slice(11,16) || null,
    tester: document.getElementById('tester').value || null,
    approved: document.getElementById('approved').value || null,
    test_result: (resultEl && resultEl.value) ? resultEl.value : null,
  };

  if(!payload.po_id){ showMsg(msg, 'Vui lòng chọn PO trước khi lưu', true); return; }

  const isEdit = !!currentEditId;
  btn.disabled = true; btn.textContent = isEdit ? 'Đang cập nhật…' : 'Đang lưu…';
  try{
    const url = isEdit ? `${API}/po-details/${currentEditId}` : `${API}/po-details`;
    const method = isEdit ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error || 'Lỗi không xác định');

    if(isEdit){
      showMsg(msg, `✓ Đã cập nhật mã ${data.Product_Code} (ID #${data.Id})`, false);
      exitEditMode();
    } else {
      showMsg(msg, `✓ Đã lưu mã ${data.Product_Code} (ID #${data.Id})`, false);
      e.target.reset();
      document.getElementById('start_datetime').value = localDateTimeValue();
      document.getElementById('end_datetime').value = '';
      document.getElementById('total_burn_time').value = '';
      syncTestDateFromStart();
      loadTable();
    }
  }catch(err){
    showMsg(msg, '✕ ' + err.message, true);
  }finally{
    btn.disabled = false; btn.textContent = isEdit ? 'Cập nhật kết quả' : 'Lưu kết quả test';
  }
});

// ---------- Quick add client ----------
document.getElementById('addClientBtn').addEventListener('click', async () => {
  const name = document.getElementById('new_client_name').value.trim();
  const msg = document.getElementById('quickMsg');
  if(!name){ showMsg(msg, 'Nhập tên khách hàng', true); return; }
  const res = await fetch(`${API}/clients`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ cus_name: name })
  });
  const data = await res.json();
  if(!res.ok){ showMsg(msg, data.error, true); return; }
  showMsg(msg, `✓ Đã thêm khách hàng "${data.Cus_Name}"`, false);
  document.getElementById('new_client_name').value = '';
  await loadClientsAndPos();
});

// ---------- Quick add PO ----------
document.getElementById('addPoBtn').addEventListener('click', async () => {
  const cus_id = document.getElementById('new_po_client').value;
  const po_name = document.getElementById('new_po_name').value.trim();
  const msg = document.getElementById('quickMsg');
  if(!cus_id || !po_name){ showMsg(msg, 'Chọn khách hàng và nhập tên PO', true); return; }
  const res = await fetch(`${API}/pos`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ cus_id: Number(cus_id), po_name })
  });
  const data = await res.json();
  if(!res.ok){ showMsg(msg, data.error, true); return; }
  showMsg(msg, `✓ Đã thêm PO "${data.PO_Name}"`, false);
  document.getElementById('new_po_name').value = '';
  await loadClientsAndPos();
});

// ---------- Filters & refresh ----------
document.getElementById('refreshBtn').addEventListener('click', loadTable);
document.getElementById('filterPo').addEventListener('change', loadTable);
document.getElementById('filterResult').addEventListener('change', loadTable);
document.getElementById('filterProduct').addEventListener('input', () => {
  clearTimeout(window._ft);
  window._ft = setTimeout(loadTable, 350);
});

// ---------- Init ----------
(async function init(){
  await loadClientsAndPos();
  await loadTable();
})();
</script>

</body>
</html>
